POSTGRESQL_URL=postgresql+psycopg2://<your_user_name>:<your_pw>@<your_host>:<your_db_port>/<your_db_name>
POSTGRESQL_HOST=<your_host>
POSTGRESQL_DB=<your_db_name>
POSTGRESQL_USERNAME=<your_user_name>
POSTGRESQL_PASSWORD=<your_pw>
PostgreSQL_PORT=<your_db_port>
POSTGRESQL_DRIVER=org.postgresql.Driver
POSTGRESQL_SCHEMA=<your_schema_name>

# Mongodb database info
MONGODB_URL=mongodb+srv://<your_user_name>:<your_pw>@<your_cluster_name>.xxxxxxx.mongodb.net/<your_db_name>?appName=<your_cluster_name>&retryWrites=true&w=majority
MONGODB_DATABASE=<your_db_name>
MONGODB_USERNAME=<your_user_name>
MONGODB_PASSWORD=<your_pw>
